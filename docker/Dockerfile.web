# Nginx com os arquivos públicos da imagem da aplicação embutidos.
# Build: docker build -f docker/Dockerfile.web --build-arg APP_IMAGE=<imagem-app> -t <imagem-web> .
ARG APP_IMAGE
FROM ${APP_IMAGE} AS application

FROM nginx:alpine
COPY --from=application /var/www/public /var/www/public
COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
RUN ln -sf /var/www/storage/app/public /var/www/public/storage
HEALTHCHECK --interval=15s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
